# Biến môi trường lúc build (đặt trong Cloudflare Pages → Settings → Environment variables)
# URL chính thức của website (dùng cho SEO, sitemap, Open Graph)
VITE_SITE_URL=https://meai-website.pages.dev
# Link tải bộ cài Windows (CDN, R2, GitHub Releases, Google Drive...).
# Bỏ trống để dùng file tĩnh tại public/downloads/MeAI-Studio-Setup-x64.exe
VITE_DOWNLOAD_URL=
