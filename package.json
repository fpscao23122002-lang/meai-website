{
  "name": "meai-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Website chính thức của MeAI - All-in-One AI Video & Marketing Automation Studio",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "deploy": "npm run build && npx wrangler@latest pages deploy dist",
    "test:api": "node --no-warnings scripts/test-api.mjs",
    "db:migrate": "wrangler d1 migrations apply meai --remote"
  },
  "dependencies": {
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.1",
    "wrangler": "^4.153.0"
  }
}
